{
  "name": "justspeak",
  "version": "0.1.0-demo.0",
  "private": true,
  "description": "Local-first voice dictation for macOS",
  "author": "FD2008",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && playwright test",
    "setup:asr": "node scripts/setup-asr.mjs",
    "bench:asr": "tsx scripts/bench-asr.ts",
    "notices": "node scripts/notices.mjs",
    "package:runtime": "tsx scripts/package-runtime.ts",
    "package:llm": "tsx scripts/package-llm-runtime.ts",
    "llm:probe": "tsx scripts/llm-probe.ts",
    "package:mac": "tsx scripts/package-runtime.ts && electron-vite build && electron-builder --mac --arm64 --dir",
    "package:mac:artifacts": "tsx scripts/package-runtime.ts && electron-vite build && electron-builder --mac --arm64",
    "package:mac:signed": "tsx scripts/package-runtime.ts && electron-vite build && tsx scripts/package-mac-signed.ts",
    "verify:mac": "tsx scripts/verify-mac-app.ts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
